<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA">

    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- JUDUL -->
        <TextView
            android:text="📌 Absensi Kehadiran"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#2C2C54"
            android:gravity="center"
            android:layout_marginBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- CARD INFO -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:elevation="6dp"
            app:cardCornerRadius="16dp">

            <LinearLayout
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/txtTime"
                    android:text="Waktu Absen"
                    android:textSize="16sp"
                    android:layout_marginBottom="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/txtLocation"
                    android:text="Lokasi: -"
                    android:textSize="14sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- CARD FOTO -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:elevation="6dp"
            app:cardCornerRadius="16dp">

            <ImageView
                android:id="@+id/imgPhoto"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:scaleType="centerCrop"
                android:background="#E0E0E0"
                android:src="@android:drawable/ic_menu_camera"/>
        </androidx.cardview.widget.CardView>

        <!-- BUTTON FOTO -->
        <Button
            android:id="@+id/btnCamera"
            android:text="Ambil Foto"
            android:backgroundTint="#6C5CE7"
            android:textColor="@android:color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- BUTTON LOKASI -->
        <Button
            android:id="@+id/btnLocation"
            android:text="Ambil Lokasi"
            android:backgroundTint="#00B894"
            android:textColor="@android:color/white"
            android:layout_marginTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- BUTTON SELESAI -->
        <Button
            android:id="@+id/btnFinish"
            android:text="Selesai Absen"
            android:backgroundTint="#0984E3"
            android:textColor="@android:color/white"
            android:layout_marginTop="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- BUTTON KEMBALI -->
        <Button
            android:id="@+id/btnBack"
            android:text="⬅Kembali"
            android:backgroundTint="#B2BEC3"
            android:textColor="#2D3436"
            android:layout_marginTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </LinearLayout>
</ScrollView>
